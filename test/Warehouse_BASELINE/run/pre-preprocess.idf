EnergyManagementSystem:Program,
  ThermalZone1PSZACOptimumStartProg0,     !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && OAT<23.9 && OAT>1.7, !- Program Line 1
  SET ThermalZone1PSZACClgSch0 = 29.4,    !- Program Line 2
  SET ThermalZone1PSZACHtgSch0 = 15.6,    !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && OAT<23.9 && OAT>1.7, !- Program Line 4
  SET ThermalZone1PSZACClgSch0 = 29.4,    !- Program Line 5
  SET ThermalZone1PSZACHtgSch0 = 15.6,    !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && OAT<23.9 && OAT>1.7, !- Program Line 7
  SET ThermalZone1PSZACClgSch0 = 29.4,    !- Program Line 8
  SET ThermalZone1PSZACHtgSch0 = 15.6,    !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && OAT<23.9 && OAT>1.7, !- Program Line 10
  SET ThermalZone1PSZACClgSch0 = 29.4,    !- Program Line 11
  SET ThermalZone1PSZACHtgSch0 = 15.6,    !- Program Line 12
  ELSE,                                   !- Program Line 13
  SET ThermalZone1PSZACClgSch0 = NULL,    !- Program Line 14
  SET ThermalZone1PSZACHtgSch0 = NULL,    !- Program Line 15
  ENDIF;                                  !- Program Line 16

